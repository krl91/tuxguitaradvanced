#!/bin/bash
# Removes GuitarFX as its macOS installer placed it (spec 027, T059, FR-026): the application and the three plugins. The sounds and
# settings (~/Library/Application Support/GuitarFX) are kept unless --remove-settings is given.
# Usage: sudo "/Applications/GuitarFX.app/Contents/Resources/guitarfx-uninstall" [--remove-settings]
# GUITARFX_UNINSTALL_ROOT puts everything under another folder (the self-test only).
set -uo pipefail
ROOT="${GUITARFX_UNINSTALL_ROOT:-}"
REMOVE_SETTINGS=false
for argument in "$@"; do
	case "$argument" in
		--remove-settings) REMOVE_SETTINGS=true ;;
		*) echo "usage: $0 [--remove-settings]" >&2; exit 2 ;;
	esac
done
if [ -z "$ROOT" ] && [ "$(id -u)" -ne 0 ]; then
	exec sudo "$0" "$@"
fi
# the guitarist's own folder, also under sudo
OWNER="${SUDO_USER:-$(id -un)}"
HOME_DIR="$(eval echo "~$OWNER")"
[ -n "$ROOT" ] && HOME_DIR="$ROOT/home"
for path in \
	"$ROOT/Library/Audio/Plug-Ins/VST3/GuitarFX.vst3" \
	"$ROOT/Library/Audio/Plug-Ins/CLAP/GuitarFX.clap" \
	"$ROOT/Library/Audio/Plug-Ins/Components/GuitarFX.component" \
	"$ROOT/Applications/GuitarFX.app"; do
	if [ -e "$path" ]; then rm -rf "$path" && echo "removed $path"; fi
done
[ -z "$ROOT" ] && pkgutil --forget app.tuxguitar.guitarfx.pkg >/dev/null 2>&1
SETTINGS="$HOME_DIR/Library/Application Support/GuitarFX"
if $REMOVE_SETTINGS; then
	rm -rf "$SETTINGS" && echo "removed $SETTINGS"
elif [ -d "$SETTINGS" ]; then
	echo "kept your sounds and settings: $SETTINGS"
fi
exit 0

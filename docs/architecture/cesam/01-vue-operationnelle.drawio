<mxfile host="app.diagrams.net" agent="TuxGuitarAdvanced docs generator" version="24.0.0"><diagram name="1 - Contexte et services (éléments statiques)" id="page751288"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Vision opérationnelle (pourquoi / quoi) : le système vu de son environnement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="n3" value="TuxGuitarAdvanced&lt;br&gt;(fork de TuxGuitar : éditeur et lecteur de tablatures + entraînement interactif)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="620" height="760" as="geometry"/></mxCell><mxCell id="n4" value="S1  Éditer et lire une tablature&lt;br&gt;(héritage TuxGuitar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="560" height="70" as="geometry"/></mxCell><mxCell id="n5" value="S2  Accorder la guitare&lt;br&gt;(accordeur évolué : hauteur, écart en cents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="230" width="560" height="70" as="geometry"/></mxCell><mxCell id="n6" value="S3  Pratiquer une piste note par note&lt;br&gt;(la partition attend la note attendue : attente-de-la-bonne-note)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="320" width="560" height="80" as="geometry"/></mxCell><mxCell id="n7" value="S4  Régler le signal d&#x27;entrée&lt;br&gt;(gain logiciel, réduction du bruit, suggestion de gain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="420" width="560" height="70" as="geometry"/></mxCell><mxCell id="n8" value="S5  Pratiquer au tempo de la partition&lt;br&gt;(décompte, suivi du tempo, avance / retard / manquée)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="510" width="560" height="80" as="geometry"/></mxCell><mxCell id="n9" value="S6  Évaluer les techniques de jeu&lt;br&gt;(hammer-on, pull-off, slide, bend, vibrato, palm mute, harmoniques…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="610" width="560" height="80" as="geometry"/></mxCell><mxCell id="n10" value="S7  Lancer la pratique en un clic&lt;br&gt;(bouton à côté de Play, et menu Outils)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="710" width="560" height="70" as="geometry"/></mxCell><mxCell id="n11" value="Guitariste apprenant&lt;br&gt;(utilisateur)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="230" height="80" as="geometry"/></mxCell><mxCell id="n12" value="Guitare&lt;br&gt;(électrique / acoustique)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="230" height="70" as="geometry"/></mxCell><mxCell id="n13" value="Interface audio ou micro intégré&lt;br&gt;(entrée instrument / micro)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="230" height="80" as="geometry"/></mxCell><mxCell id="n14" value="Système d&#x27;exploitation&lt;br&gt;(macOS : autorisation du micro, Java Sound)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="230" height="80" as="geometry"/></mxCell><mxCell id="n15" value="Fichiers de tablature&lt;br&gt;(.tg, .gp3, .gp4, .gp5, .gpx…)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="280" height="80" as="geometry"/></mxCell><mxCell id="n16" value="Casque / haut-parleurs&lt;br&gt;(lecture MIDI de la partition)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="250" width="280" height="70" as="geometry"/></mxCell><mxCell id="n17" value="GitHub (dépôt, releases)&lt;br&gt;projet amont helge17/tuxguitar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="710" width="280" height="80" as="geometry"/></mxCell><mxCell id="n18" value="ouvre, édite, joue la note attendue,&lt;br&gt;lit le retour visuel (S1, S3)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.3816; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="signal analogique" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="signal audio numérisé (S2, S3)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.7632; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="autorisation du micro" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.9211; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="lecture / écriture (S1)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.1316; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="son MIDI (S1)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.2697;entryX=0;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="mises à jour, releases" style="endArrow=classic;html=1;dashed=1;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.8816; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="Existant (MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="140" height="30" as="geometry"/></mxCell><mxCell id="n26" value="Prévu (spec 002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="910" width="160" height="30" as="geometry"/></mxCell><mxCell id="n27" value="Acteur / élément externe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="910" width="190" height="30" as="geometry"/></mxCell><mxCell id="n28" value="Acteur principal : le guitariste apprenant. Le système ne remplace pas un professeur : il dit ce qui a été entendu, pas comment le jeu a été produit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="560" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Scénario nominal (pratique note par note)" id="page616446"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Vision opérationnelle : scénario nominal, pratiquer une piste" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Guitariste" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="70" width="260" height="44" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="228" y="120" width="4" height="640" as="geometry"/></mxCell><mxCell id="n5" value="TuxGuitarAdvanced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="260" height="44" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="708" y="120" width="4" height="640" as="geometry"/></mxCell><mxCell id="n7" value="Interface audio / micro" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="260" height="44" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1188" y="120" width="4" height="640" as="geometry"/></mxCell><mxCell id="n9" value="1  Ouvre un fichier de tablature" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.0156;entryX=0;entryY=0.0156;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="2  Clique sur le bouton Practice (ou Outils &gt; Practice)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.0938;entryX=0;entryY=0.0938;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="3  Ouvre la fenêtre pour la piste choisie" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.1719;entryX=1;entryY=0.1719;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="4  Choisit l&#x27;entrée audio" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.2500;entryX=0;entryY=0.2500;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="5  Demande le signal (autorisation du micro)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.3281;entryX=0;entryY=0.3281;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="6  Envoie le signal audio" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.4062;entryX=1;entryY=0.4062;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="7  Contrôle de niveau : convient / trop faible / saturé" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.4844;entryX=1;entryY=0.4844;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="8  Joue la note attendue (affichée : note, corde, case)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5625;entryX=0;entryY=0.5625;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="9  Retour : note détectée, écart en cents, correct / incorrect / incertain" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.6406;entryX=1;entryY=0.6406;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="10  Note juste : avance à la note suivante (sinon attend)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.7188;entryX=1;entryY=0.7188;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="11  Termine la piste, ou arrête / passe une note" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.8125;entryX=0;entryY=0.8125;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="12  Bilan (passages réussis, retentatives)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.9062;entryX=1;entryY=0.9062;labelBackgroundColor=#ffffff;verticalAlign=bottom; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="Alternatives : entrée inutilisable ou accordeur ouvert ou lecture lancée : la pratique se met en pause avec la raison, puis attend « Reprendre ». Note non reconnue (silence, bruit, incertain) : jamais d&#x27;avance." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="790" width="1300" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 - États, propriétés attendues, interfaces" id="page214741"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Vision opérationnelle : états d&#x27;usage, propriétés attendues, interfaces avec l&#x27;environnement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Édition / lecture&lt;br&gt;(pas d&#x27;entraînement)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="80" as="geometry"/></mxCell><mxCell id="n4" value="Accordage&lt;br&gt;(accordeur)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="260" height="80" as="geometry"/></mxCell><mxCell id="n5" value="Pratique : attente de la bonne note&lt;br&gt;(existant)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Pratique au tempo&lt;br&gt;(prévu)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="300" height="80" as="geometry"/></mxCell><mxCell id="n7" value="Pause (raison affichée)&lt;br&gt;entrée inutilisable, accordeur ouvert,&lt;br&gt;entrée changée, lecture lancée" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="340" height="100" as="geometry"/></mxCell><mxCell id="n8" value="Practice" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="Arrêter" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.7; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="Outils &gt; Accordeur" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="Practice (mode tempo)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=1;exitY=0.9;entryX=0;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="172"/><mxPoint x="400" y="320"/></Array></mxGeometry></mxCell><mxCell id="n12" value="cause de pause" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="Reprendre" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.7; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;Propriétés attendues (provisoires, à mesurer)&lt;/b&gt;&lt;br&gt;• Retour perçu comme immédiat : médiane ≤ 150 ms (spec 002, SC-003), p95 ≤ 250 ms&lt;br&gt;• 95 % des notes reconnues à 8 notes par seconde, moins de 1 % de fausses acceptations (SC-002)&lt;br&gt;• Honnêteté : seule la hauteur est validée ; corde, case et techniques non prouvées sont dites « non vérifiables »&lt;br&gt;• Une note incertaine n&#x27;est jamais présentée comme une erreur&lt;br&gt;• Aucun enregistrement ni conservation de l&#x27;audio&lt;br&gt;• Français et anglais pour tous les textes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="680" height="200" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Interfaces avec l&#x27;environnement&lt;/b&gt;&lt;br&gt;• Utilisateur : fenêtre Practice, surlignage dans la partition, bouton de barre de transport&lt;br&gt;• Matériel audio : flux PCM 16/24 bits mono via Java Sound (TargetDataLine)&lt;br&gt;• Système : autorisation du micro (macOS), lanceur natif signé&lt;br&gt;• Fichiers : formats de tablature lus par TuxGuitar&lt;br&gt;• Distribution : paquets macOS / Linux / Windows sur GitHub Releases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="430" width="680" height="200" as="geometry"/></mxCell><mxCell id="n16" value="Existant (MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="140" height="30" as="geometry"/></mxCell><mxCell id="n17" value="Prévu (spec 002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="700" width="160" height="30" as="geometry"/></mxCell><mxCell id="n18" value="Acteur / élément externe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="700" width="190" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
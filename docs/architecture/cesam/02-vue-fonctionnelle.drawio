<mxfile host="app.diagrams.net" agent="TuxGuitarAdvanced docs generator" version="24.0.0"><diagram name="1 - Fonctions et flux de données (éléments statiques)" id="page670364"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Vision fonctionnelle (quoi / comment) : fonctions et flux de données" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1610" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Signal de la guitare" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="40" as="geometry"/></mxCell><mxCell id="n4" value="F1  Capturer l&#x27;audio&lt;br&gt;(lecture du flux, file tampon sans verrou)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="n5" value="F2  Conditionner le signal&lt;br&gt;(gain, passe-haut, noise gate, soustraction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="n6" value="F3  Analyser&lt;br&gt;(niveau, hauteur YIN, attaque, spectre polyphonique)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="n7" value="F4  Extraire les indices de technique&lt;br&gt;(glissé, vibrato, décroissance, spectre)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="n8" value="F5  Interpréter&lt;br&gt;(note MIDI la plus proche, écart en cents, tolérance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="350" width="260" height="90" as="geometry"/></mxCell><mxCell id="n9" value="F9  Juger les techniques&lt;br&gt;(détectée / non détectée / incertaine / non vérifiable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="350" width="260" height="90" as="geometry"/></mxCell><mxCell id="n10" value="Partition&lt;br&gt;(TGSong : pistes, mesures, notes, effets)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="260" height="90" as="geometry"/></mxCell><mxCell id="n11" value="F6  Construire la séquence attendue&lt;br&gt;(ordre de lecture, répétitions, accords)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="550" width="260" height="90" as="geometry"/></mxCell><mxCell id="n12" value="F7  Juger&lt;br&gt;(attente de la bonne note : attaque fraîche, stabilité)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="550" width="260" height="90" as="geometry"/></mxCell><mxCell id="n13" value="F8  Suivre le tempo&lt;br&gt;(horloge, fenêtres de tolérance, resynchronisation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="550" width="260" height="90" as="geometry"/></mxCell><mxCell id="n14" value="F10  Restituer&lt;br&gt;(retour visuel, surlignage, bilan de passage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="750" width="260" height="90" as="geometry"/></mxCell><mxCell id="n15" value="Guitariste" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="260" height="90" as="geometry"/></mxCell><mxCell id="n16" value="" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="échantillons (mono)" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="signal conditionné" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="trames" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="trame : f0, confiance,&lt;br&gt;niveau, attaque" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="indices" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="pistes et mesures" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relat
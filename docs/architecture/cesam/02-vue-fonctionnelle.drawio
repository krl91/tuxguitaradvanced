mxCell id="n2" value="Vision fonctionnelle : états de la session de pratique (PracticeSession)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="n3" value="PREPARING&lt;br&gt;(entrée et piste à valider)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="80" as="geometry"/></mxCell><mxCell id="n4" value="RUNNING&lt;br&gt;(attend la note attendue)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="240" height="80" as="geometry"/></mxCell><mxCell id="n5" value="PAUSED&lt;br&gt;(INPUT_UNUSABLE, TUNER_OPEN,&lt;br&gt;INPUT_CHANGED, PLAYBACK)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n6" value="READY_TO_RESUME&lt;br&gt;(causes levées)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="300" height="80" as="geometry"/></mxCell><mxCell id="n7" value="COMPLETE&lt;br&gt;(dernier événement accepté)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="560" width="240" height="80" as="geometry"/></mxCell><mxCell id="n8" value="STOPPED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="260" height="80" as="geometry"/></mxCell><mxCell id="n9" value="Start (entrée convenable,&lt;br&gt;piste acceptée)" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="cause de pause" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="toutes les causes résolues" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="Resume" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.85; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="380"/><mxPoint x="880" y="188"/></Array></mxGeometry></mxCell><mxCell id="n13" value="dernier événement" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0.4;exitY=1;entryX=0.4;entryY=0; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="Restart" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0.75;exitY=0;entryX=0.75;entryY=1; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="Stop" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0.1;exitY=1;entryX=0.5;entryY=0; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="Prévu : états COUNT_IN et FOLLOWING (mode au tempo, FollowSession). Aucun état n&#x27;attend une note fausse ou manquée." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Sous-états de l&#x27;événement courant (extrait du code)&lt;/b&gt;&lt;br&gt;• l&#x27;attaque arme l&#x27;acceptation&lt;br&gt;• la hauteur attendue doit rester dans la tolérance pendant la fenêtre de stabilité&lt;br&gt;• silence, bruit, incertain ou attaque sans hauteur stable : jamais d&#x27;avance&lt;br&gt;• une note fausse fraîche, tenue pendant la fenêtre, donne un verdict « incorrect »" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=12;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1100" height="100" as="geometry"/></mxCell><mxCell id="n18" value="Existant (MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="850" width="140" height="30" as="geometry"/></mxCell><mxCell id="n19" value="Prévu (spec 002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="850" width="160" height="30" as="geometry"/></mxCell><mxCell id="n20" value="Acteur / élément externe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="850" width="190" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 - Scénario : acceptation d&#x27;une note" id="page185633"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Vision fonctionnelle : scénario, traitement d&#x27;une trame d&#x27;analyse en mode attente" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Nouvelle trame&lt;br&gt;(f0, confiance, niveau, attaque)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="260" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Attaque fraîche depuis la&lt;br&gt;dernière acceptation ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="320" height="100" as="geometry"/></mxCell><mxCell id="n5" value="Armer l&#x27;acceptation&lt;br&gt;(mémoriser l&#x27;instant de l&#x27;attaque)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="185" width="280" height="70" as="geometry"/></mxCell><mxCell id="n6" value="Niveau utilisable et lecture&lt;br&gt;fiable sur la note attendue&lt;br&gt;(dans la tolérance) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="320" width="360" height="120" as="geometry"/></mxCell><mxCell id="n7" value="Fenêtre de stabilité atteinte&lt;br&gt;et acceptation armée ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="490" width="360" height="120" as="geometry"/></mxCell><mxCell id="n8" value="Accepter&lt;br&gt;(✓, avancer à l&#x27;événement suivant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="670" width="320" height="70" as="geometry"/></mxCell><mxCell id="n9" value="Autre note fraîche,&lt;br&gt;stable et fiable ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="335" width="300" height="90" as="geometry"/></mxCell><mxCell id="n10" value="Verdict « incorrect »&lt;br&gt;(✗ après la fenêtre)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="480" width="260" height="70" as="geometry"/></mxCell><mxCell id="n11" value="Attendre&lt;br&gt;(rien ne change)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="660" width="260" height="60" as="geometry"/></mxCell><mxCell id="n12" value="" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="oui" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="non" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0.5;exitY=1;entryX=1;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="380"/></Array></mxGeometry></mxCell><mxCell id="n16" value="oui" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="non" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="oui" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="non" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="550"/><mxPoint x="440" y="690"/></Array></mxGeometry></mxCell><mxCell id="n20" value="oui" style="endArrow=classic;html=1;rounded=0;fontSize=11; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="non" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5; labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="380"/><mxPoint x="40" y="690"/></Array></mxGeometry></mxCell><mxCell id="n22" value="Prévu (Phase C) : une note de hauteur différente de la précédente pourra être acceptée sur un changement de hauteur stable sans attaque confirmée (legato) ; vérification directe de la hauteur attendue pour réduire la latence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="480" height="120" as="geometry"/></mxCell><mxCell id="n23" value="Existant (MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="140" height="30" as="geometry"/></mxCell><mxCell id="n24" value="Prévu (spec 002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="910" width="160" height="30" as="geometry"/></mxCell><mxCell id="n25" value="Acteur / élément externe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="910" width="190" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 - Interfaces et propriétés des fonctions" id="page268805"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Vision fonctionnelle : interfaces entre fonctions et propriétés attendues" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Interfaces (extraites du code)&lt;/b&gt;&lt;br&gt;• Échantillons → trames : file tampon SampleRingBuffer (un producteur, un consommateur)&lt;br&gt;• Trames → consommateurs : AnalysisService.Listener.analysisFrame(AnalysisFrame)&lt;br&gt;• Trames et commandes → session : SessionLoop.Handler.onFrame / onCommand (un seul écrivain de l&#x27;état)&lt;br&gt;• Session → écran : instantané PracticeSnapshot, au plus une livraison par 33 ms (≈ 30 par seconde)&lt;br&gt;• Commandes de l&#x27;utilisateur : actions practice.start, practice.skip, practice.resume, practice.stop, practice.open&lt;br&gt;• Lecteur MIDI → session : événements de démarrage / arrêt de lecture (MidiPlayerEvent)&lt;br&gt;• Prévu : AudioEngine.setInputGain, setNoiseReductionEnabled, suggestGain ; setExpectedPitches ; TechniqueDetector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1400" height="200" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Propriétés attendues par fonction&lt;/b&gt;&lt;br&gt;• F1 Capturer : aucun blocage, aucune allocation non bornée sur le chemin temps réel ; dégradation claire si le périphérique disparaît&lt;br&gt;• F2 Conditionner : neutre par défaut (identique au MVP) ; latence ajoutée comptée ; le gain n&#x27;est jamais enregistré&lt;br&gt;• F3 Analyser : fenêtres glissantes déterministes, testables avec des signaux synthétiques&lt;br&gt;• F5 Interpréter : tolérance d&#x27;acceptation ≥ tolérance d&#x27;accordage ; hauteur seule, corde et case jamais déclarées vérifiées&lt;br&gt;• F7 Juger : attendre est préféré à une fausse réussite ; chaque seuil est un paramètre, pas une constante de produit&lt;br&gt;• F9 Juger les techniques : quatre verdicts ; « non vérifiable » tant qu&#x27;aucun benchmark ne justifie « vérifié »&lt;br&gt;• F10 Restituer : comprendre ce qui était attendu, ce qui a été entendu, l&#x27;écart ; l&#x27;incertain est dit incertain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1400" height="240" as="geometry"/></mxCell><mxCell id="n5" value="Existant (MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="140" height="30" as="geometry"/></mxCell><mxCell id="n6" value="Prévu (spec 002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="600" width="160" height="30" as="geometry"/></mxCell><mxCell id="n7" value="Acteur / élément externe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="600" width="190" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
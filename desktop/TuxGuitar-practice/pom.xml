<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>tuxguitar-pom</artifactId>
		<groupId>app.tuxguitar</groupId>
		<version>9.99-SNAPSHOT</version>
		<relativePath>../</relativePath>
	</parent>

	<modelVersion>4.0.0</modelVersion>
	<artifactId>tuxguitar-practice</artifactId>
	<packaging>jar</packaging>
	<name>${project.artifactId}</name>

	<build>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>share</directory>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>test-resources</directory>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- uses tuxguitar-audio-engine (Java 11); this module only (parent stays at 9) -->
					<release>11</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!-- JUnit 5 and the group filters need surefire 3 (older Maven releases default to 2.12.4) -->
				<version>3.2.5</version>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<!-- TarsosDSP is not on Maven Central (test scope here, see the audio engine) -->
		<repository>
			<id>tarsos-dsp</id>
			<url>https://mvn.0110.be/releases</url>
		</repository>
	</repositories>

	<properties>
		<!-- the native SWT test of the Configuration page runs only with -P swt-gui-tests,
		     in a macOS graphical session (it needs the WindowServer) -->
		<excludedGroups>swt-gui</excludedGroups>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-lib</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-editor-utils</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-ui-toolkit</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-audio-engine</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
			<exclusions>
				<!-- TarsosDSP stays behind the engine API: not visible to this module's code -->
				<exclusion>
					<groupId>be.tarsos.dsp</groupId>
					<artifactId>core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<!-- the engine's test support: synthetic signals and technique signals (spec 002 T002, T003) -->
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-audio-engine</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!-- the Guitar Pro readers, to read real scores in the optional corpus validation of Arcade (spec 003 T060 to T065); test scope only -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gtp</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- the real javax.sound sequencer behind the real MidiPlayer, for the long Arcade stress run (spec 003 T047); test scope only -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-jsa</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.9.2</version>
			<scope>test</scope>
		</dependency>
		<!-- tests only: the engine really runs its analysis when the settings page's values are
		     checked end to end (T102); main code still cannot see TarsosDSP (exclusion above) -->
		<dependency>
			<groupId>be.tarsos.dsp</groupId>
			<artifactId>core</artifactId>
			<version>2.5</version>
			<scope>test</scope>
		</dependency>
		<!-- tests only: the settings page's values must reach the tuner (T102) -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-tuner-next</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- mvn test -P swt-gui-tests -pl ../../TuxGuitar-practice -am -Dtest=RecognitionSettingsSwtTest
		     -Dsurefire.failIfNoSpecifiedTests=false, from the macOS SWT build directory, in a graphical session -->
		<profile>
			<id>swt-gui-tests</id>
			<properties>
				<groups>swt-gui</groups>
				<excludedGroups></excludedGroups>
			</properties>
			<dependencies>
				<dependency>
					<groupId>${project.groupId}</groupId>
					<artifactId>tuxguitar-ui-toolkit-swt</artifactId>
					<version>${project.version}</version>
					<scope>test</scope>
				</dependency>
				<dependency>
					<groupId>${org.eclipse.swt.groupId}</groupId>
					<artifactId>${org.eclipse.swt.artifactId}</artifactId>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<!-- SWT on macOS must own the main thread -->
							<argLine>-XstartOnFirstThread</argLine>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>

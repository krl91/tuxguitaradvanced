<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>tuxguitar-pom</artifactId>
		<groupId>app.tuxguitar</groupId>
		<version>9.99-SNAPSHOT</version>
		<relativePath>../</relativePath>
	</parent>

	<modelVersion>4.0.0</modelVersion>
	<artifactId>tuxguitar-audio-engine</artifactId>
	<packaging>jar</packaging>
	<name>${project.artifactId}</name>

	<repositories>
		<!-- TarsosDSP is not on Maven Central -->
		<repository>
			<id>tarsos-dsp</id>
			<url>https://mvn.0110.be/releases</url>
		</repository>
	</repositories>

	<build>
		<sourceDirectory>src/main/java</sourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- TarsosDSP 2.5 is Java 11 bytecode; this module only (parent stays at 9) -->
					<release>11</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<!-- the engine's test support (synthetic signals, fake audio input) is reused by the practice module's tests; never packaged into the application -->
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!-- JUnit 5 and the group filters need surefire 3 (older Maven releases default to 2.12.4) -->
				<version>3.2.5</version>
			</plugin>
		</plugins>
	</build>

	<properties>
		<!-- recorded-audio benchmark runs only on request: -Dgroups=benchmark -DexcludedGroups= -->
		<excludedGroups>benchmark</excludedGroups>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-lib</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>be.tarsos.dsp</groupId>
			<artifactId>core</artifactId>
			<version>2.5</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.9.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
